# Studio Production Commander - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_API_KEY=your-gemini-api-key-here

# Grafana Cloud - QUERY path (read).
# Service account token created inside the Grafana instance, sent as a Bearer
# credential. Used by mcp-gateway to reach the Grafana MCP server.
GRAFANA_MCP_SERVER_URL=https://your-stack.grafana.net/api/mcp
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here

# Grafana Cloud - INGEST path (write).
# Access policy token from the grafana.com portal with metrics:write, logs:write
# and traces:write, sent as HTTP Basic with the numeric instance ID as username.
# A different credential from the query token above - do not reuse one for both.
GRAFANA_OTLP_ENDPOINT_URL=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=your_numeric_otlp_instance_id
GRAFANA_ACCESS_POLICY_TOKEN=glc_your_access_policy_token_here

# Simulator export cadence, independent of the simulation tick rate.
OTEL_EXPORT_INTERVAL_SEC=15
# Set to 1 while validating the pipeline; raise to 24 for the multi-tenant demo.
NUM_TENANT_WORLDS=24

# Memorystore / Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firestore Configuration
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

# Cloud SQL / PostgreSQL Production Metadata Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studio_production

# Pub/Sub Configuration
PUBSUB_RUNS_TOPIC=studio-production-runs
PUBSUB_RUNS_SUBSCRIPTION=studio-production-runs-sub

# Service Endpoints (Internal / Cloud Run URLs)
MCP_GATEWAY_URL=http://localhost:8001
IMPACT_ENGINE_URL=http://localhost:8002
ACTION_EXECUTOR_URL=http://localhost:8003
RENDER_SIM_URL=http://localhost:8004
API_GATEWAY_URL=http://localhost:8000
STREAM_SERVICE_URL=http://localhost:8005

# Rate Limits & Capacity
MCP_GLOBAL_QPS_LIMIT=25
GEMINI_MAX_CONCURRENT_CALLS=15
TENANT_LEASE_TTL_SECONDS=1200
