# Studio Production Commander - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Google Cloud / Gemini.
# Preferred path: set GOOGLE_CLOUD_PROJECT and authenticate with Application
# Default Credentials (`gcloud auth application-default login` locally, the
# service account identity on Cloud Run). No key material is stored anywhere.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Use `global`, not a named region: us-central1 serves only the Gemini 2.5
# generation, while the global endpoint also serves 3.x.
GOOGLE_CLOUD_LOCATION=global

# ADK reads this to route through Vertex AI rather than the Developer API.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Fallback for local work on a machine without gcloud. Leave empty when using ADC;
# GOOGLE_CLOUD_PROJECT takes precedence if both are set.
GEMINI_API_KEY=

# Grafana Cloud - QUERY path (read).
#
# The MCP server runs locally (scripts/run_mcp_grafana.py) rather than using
# Grafana Cloud's hosted one, which authenticates through an OAuth browser flow a
# headless worker cannot complete. The local server authenticates to your stack
# with the service account token below.
#
# GRAFANA_STACK_URL is your instance; GRAFANA_MCP_SERVER_URL is where the local
# MCP server listens. They are deliberately different.
GRAFANA_STACK_URL=https://your-stack.grafana.net
GRAFANA_MCP_SERVER_URL=http://localhost:8081/mcp
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here

# Scopes on the service account above.
#
# Queries need read scopes only. The post-approval write-back additionally needs
# `annotations:create` (verified against a live stack: without it Grafana answers
# 403 postAnnotationForbidden) and the equivalent incident write permission,
# because an approved remediation is marked on the Grafana timeline and, when a
# delivery is at risk, opens an incident. Those tools are reachable only through
# the gateway's /write endpoint and never from the agent's query path, so
# widening the token does not widen what the model can do. Without them the
# investigation still runs and the Grafana writes are reported as failed rather
# than silently skipped. Run scripts/verify_live.py to check.

# Grafana Cloud - INGEST path (write).
# Access policy token from the grafana.com portal with metrics:write, logs:write
# and traces:write, sent as HTTP Basic with the numeric instance ID as username.
# A different credential from the query token above - do not reuse one for both.
#
# Used by render-sim for farm metrics, logs and traces, and by agent-worker for
# the agent's own traces. ADK emits GenAI spans for every LLM call, tool call and
# token count, so with these set the agent's behaviour and cost land in the same
# stack, on the same timeline, as the telemetry it is investigating.
GRAFANA_OTLP_ENDPOINT_URL=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=your_numeric_otlp_instance_id
GRAFANA_ACCESS_POLICY_TOKEN=glc_your_access_policy_token_here

# Simulator export cadence, independent of the simulation tick rate.
OTEL_EXPORT_INTERVAL_SEC=15
# Set to 1 while validating the pipeline; raise to 24 for the multi-tenant demo.
NUM_TENANT_WORLDS=24

# One frame-render trace per worker per export interval, broken into asset fetch,
# GPU render and output write. Set false to cut span volume when running all 24
# worlds against a small stack.
EMIT_RENDER_TRACES=true

# Whether the connected MCP server offers a trace-search tool. True for the
# vendored mcp-grafana build, which exposes tempo_traceql-search. Set false when
# pointing at a server without it: the trace-attribution criterion then reports as
# skipped instead of failing, so it does not cap the achievable confidence.
TEMPO_SEARCH_AVAILABLE=true

# Give the agent a metric-name discovery tool and let it enumerate the farm's
# series itself, instead of handing it the list in the prompt. Costs a turn.
ENABLE_METRIC_DISCOVERY=true

# Post-approval write-back into Grafana: annotate the timeline, and open an
# incident when a deliverable is at risk.
GRAFANA_WRITEBACK_ENABLED=true
# Incidents are filed as drills because the render farm behind them is simulated.
# Turn off only for a deployment backed by a real farm.
GRAFANA_INCIDENT_IS_DRILL=true
# Opening an incident requires the Grafana Incident (IRM) app to be provisioned
# for the org. Where it is not, creation fails inside the incident service's own
# database even though list_incidents answers normally. Annotations are
# unaffected, so set this false to skip the attempt cleanly.
GRAFANA_INCIDENT_ENABLED=true

# Memorystore / Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firestore Configuration
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

# Cloud SQL / PostgreSQL Production Metadata Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studio_production

# Pub/Sub Configuration
PUBSUB_RUNS_TOPIC=studio-production-runs
PUBSUB_RUNS_SUBSCRIPTION=studio-production-runs-sub

# Service Endpoints (Internal / Cloud Run URLs)
MCP_GATEWAY_URL=http://localhost:8001
IMPACT_ENGINE_URL=http://localhost:8002
ACTION_EXECUTOR_URL=http://localhost:8003
RENDER_SIM_URL=http://localhost:8004
API_GATEWAY_URL=http://localhost:8000
STREAM_SERVICE_URL=http://localhost:8005

# Rate Limits & Capacity
MCP_GLOBAL_QPS_LIMIT=25
GEMINI_MAX_CONCURRENT_CALLS=15
TENANT_LEASE_TTL_SECONDS=1200
